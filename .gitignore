# Facturas reales: llevan CUPS, nombre, direccion y cuenta bancaria.
# Este repo es publico. NUNCA entran en git.
facturas-prueba/
*.pdf

# Descargas y trabajo del actualizador
descargas/
tmp/

node_modules/
dist/

# Volcados de sondeo: llevan el texto de las facturas (nombre, direccion, CUPS).
sondeo/

# Dataset curado de la Plataforma de ForoCoches: se usa en local, no se republica.
# Quien lo quiera, que baje el Excel del hilo y ejecute: npm run actualizar
datos/tarifas-excel.json
app/public/tarifas-excel.json

# Ficheros de la etapa anterior, cuando las dos fuentes iban juntas
datos/tarifas.json
app/public/tarifas.json

# Log de la tarea semanal
actualizar-semanal.log

# Proyecto Android que genera Capacitor (npx cap add android)
app/android/

# Claves de firma: nunca en git
*.keystore
*.jks
keystore.properties

# APK generados
*.apk

# --- Datos: lista BLANCA, no negra ---
# Un fichero viejo renombrado (tarifas-viejo-fusionado.json) se colo al repo
# publico porque la lista era de nombres concretos. Ahora se ignora TODO y se
# permite solo lo que de verdad se publica.
datos/*.json
!datos/tarifas-cnmc.json
app/public/*.json
!app/public/tarifas-cnmc.json

# Entregables y capturas de prueba
entregas/
